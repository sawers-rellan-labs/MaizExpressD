// MaizExpressD settings for nf-core/rnaseq.
// Use together with the nf-core institutional profile for Hazel (Slurm + Singularity):
//   nextflow run nf-core/rnaseq -r <version> -profile hazel -c conf/maizexpressd.config ...
// run_study.sh does this; see pipeline/README.md. Copied from MaizExpressC (29 Oct 2026).

params {
    // B73 RefGen_v5 (Zm-B73-REFERENCE-NAM-5.0), gene models Zm00001eb.1. run_study.sh restores the
    // reference bundle (these files plus the saved salmon index) from MaizExpressN's backup on sara.
    fasta = '/share/maize/rrellan/MaizExpressD/reference/Zm-B73-REFERENCE-NAM-5.0.fa.gz'
    gff   = '/share/maize/rrellan/MaizExpressD/reference/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz'

    // Salmon pseudo-alignment only, decoy-aware index (transcripts + genome as decoys),
    // selective alignment (salmon's default).
    pseudo_aligner        = 'salmon'
    skip_alignment        = true
    trimmer               = 'fastp'
    skip_bbsplit          = true
    skip_biotype_qc       = true
    // gtf_extra_attributes stays at the nf-core default ('gene_name'): MaizeGDB models have no
    // gene_name, so the pipeline fills that column with gene_id. An empty value breaks tximport.
    save_reference        = true
}

// Slurm account and QoS for every task job (Hazel: account maize_cpu; QoS normal = 4 days).
process {
    clusterOptions = '--account=maize_cpu --qos=normal'
    // the hazel profile runs 'module load singularity'; batch shells need the module system first
    beforeScript   = 'source /etc/profile.d/modules.sh && module load singularity'

    withName: '.*:MAKE_TRANSCRIPTS_FASTA' {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
    }
    // 3' tag libraries of ~5.5 M reads: small jobs that backfill quickly. The decoy-aware
    // index (9.2 GB on disk) needs ~10 GB of memory once loaded.
    withName: '.*:SALMON_QUANT' {
        cpus   = 6
        memory = 16.GB
        time   = 2.h
    }
    withName: '.*:SALMON_INDEX' {
        cpus           = 16
        memory         = 64.GB
        time           = 12.h
        queue          = 'compute_partners'
        clusterOptions = '--account=maize_cpu --qos=p_maize'
    }
}

singularity {
    cacheDir = '/share/maize/rrellan/MaizExpressD/singularity'
}
